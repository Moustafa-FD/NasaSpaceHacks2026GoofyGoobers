# Local demo. Put a full executable path here if python is not on PATH.
PYTHON_EXECUTABLE=python
PORT=3000
WORKER_TIMEOUT_MS=30000
# This is used by the CLI demo client, not as the API's bind address.
API_BASE_URL=http://127.0.0.1:3000
# Future live adapters: credentials are deliberately not required by the demo.
# Earthdata credentials belong in your local credential store, never Git.
