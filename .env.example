# Local environmental API. Optional override for the Python used to create .venv.
PYTHON_EXECUTABLE=python
PORT=3000
DATA_WORKER_TIMEOUT_MS=1200000
# The data worker automatically uses .venv after npm run data:setup.
# DATA_PYTHON_EXECUTABLE=C:/path/to/python.exe
# This is used by the CLI demo client, not as the API's bind address.
API_BASE_URL=http://127.0.0.1:3000
# NASA POWER public grid/point and CMR metadata do not need Earthdata credentials.
# Giovanni/AppEEARS observation extraction remains a separate authenticated adapter.
# Store any later Earthdata credentials locally, never in Git or the Unreal client.
