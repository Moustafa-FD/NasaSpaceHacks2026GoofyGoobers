{
  "name": "goofy-goobers-impact-platform",
  "version": "0.1.0",
  "private": true,
  "description": "NASA Space Apps data-center environmental and community impact starter",
  "type": "module",
  "engines": { "node": ">=24.12.0 <27" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch apps/api/src/server.ts",
    "start": "node --env-file-if-exists=.env apps/api/src/server.ts",
    "demo": "node --env-file-if-exists=.env scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/api.test.ts",
    "test:models": "python -m unittest discover -s services/models/tests -v",
    "check": "npm run typecheck && npm test && npm run test:models",
    "web": "node apps/web/server.cjs",
    "data:nasa": "python scripts/precompute.py",
    "data:unreal": "node scripts/export_unreal.cjs"
  },
  "dependencies": { "ajv": "^8.17.1", "ws": "^8.18.0" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/ws": "^8.18.0", "typescript": "~5.9.3" }
}
